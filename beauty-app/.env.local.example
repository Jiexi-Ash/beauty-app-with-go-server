# Go API base URL (server-only — the browser never talks to it directly,
# it goes through app/api/auth/* and app/api/go/* route handlers instead).
GO_API_URL=http://localhost:8080

# CloudFront hostname (S3_CF_DISTRO on the Go API) that cover-image uploads
# are served from — needed so next/image is allowed to load them.
NEXT_PUBLIC_S3_CF_DISTRO=
